AUTONOMOUS_MODE=true
REQUIRE_APPROVAL_BEFORE_PUBLISH=true
SCENE_CONCURRENCY=0
TAVILY_ENABLED=true
OPENROUTER_ENABLED=true
OPENROUTER_MODEL=openai/gpt-4o-mini
FREE_ROUTER_ENABLED=false
FIRECRAWL_ENABLED=true
BRAVE_SEARCH_ENABLED=true
SENDGRID_ENABLED=false
VERCEL_ENABLED=false
PROVIDER_REGISTRY_HOST_PATH=./provider-registry.json
PUBLIC_LAUNCH=false
APP_AUTH_SECRET=
FORCE_SECURE_COOKIE=false
WRITE_RATE_LIMIT=120

# Terminal provider-job audit records are retained for this many days.
PROVIDER_JOB_RETENTION_DAYS=30
# Unified Google OAuth: main-app owner login + YouTube channel authorization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OWNER_EMAILS=
GOOGLE_OAUTH_REDIRECT_URI=https://cortexbuildpro.tech/api/oauth/google/callback
GOOGLE_LOGIN_ALLOW_ANY=false

# YouTube publishing stays disabled until the channel OAuth grant is connected.
YOUTUBE_PUBLISH_ENABLED=false
YOUTUBE_CATEGORY_ID=22
# Legacy overrides remain supported; normally leave these blank when GOOGLE_* is set.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# TikTok / Instagram publishing and read-only analytics stay disabled until explicitly authorized.
TIKTOK_PUBLISH_ENABLED=false
TIKTOK_ACCESS_TOKEN=
TIKTOK_DEFAULT_PRIVACY=SELF_ONLY
TIKTOK_ANALYTICS_ENABLED=false
TIKTOK_SCOPES=
AUTO_EXECUTE_SCHEDULED_TIKTOK=false
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_ANALYTICS_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v26.0
AUTO_EXECUTE_SCHEDULED_INSTAGRAM=false
