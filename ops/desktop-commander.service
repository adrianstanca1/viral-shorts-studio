[Unit]
Description=Desktop Commander Remote Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
SupplementaryGroups=docker
Environment=HOME=/home/administrator
WorkingDirectory=/home/administrator
ExecStart=/usr/bin/npx -y @wonderwhy-er/desktop-commander@latest remote
Restart=always
RestartSec=5
StandardOutput=append:/home/administrator/dc-service.log
StandardError=append:/home/administrator/dc-service.log

[Install]
WantedBy=multi-user.target
